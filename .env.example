# Browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# These names are also supported for deployments that use Next.js-style env vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Paystack public key (used for Paystack Inline JS popup in the browser)
# Get this from https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=

# Server configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment provider server keys (never expose to the browser)
# Paystack secret key — from https://dashboard.paystack.com/#/settings/developers
# This key is used for:
#   1. Verifying transactions via Paystack's /transaction/verify/ API
#   2. Signing/verifying Paystack webhook deliveries (HMAC-SHA512)
# No separate webhook secret is needed — Paystack uses this same key for both.
PAYSTACK_SECRET_KEY=
# Flutterwave secret key (optional, if using Flutterwave as an alternative)
FLUTTERWAVE_SECRET_KEY=
